<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FDFAFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="20dp"
        android:paddingTop="4dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning,"
                    android:textColor="#4A4A4A"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/txtUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dailya"
                    android:textColor="#7C5FC2"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Let's make today amazing!"
                    android:textColor="#9E9E9E"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/logo" />
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:layout_marginHorizontal="-15dp"
            android:layout_marginBottom="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="Mood"
                    android:textColor="#2D2D2D"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Happy -->
                    <FrameLayout
                        android:id="@+id/moodHappyContainer"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1">

                        <ImageButton
                            android:id="@+id/mood_happy"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:background="@android:color/transparent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_mood_happy"/>
                    </FrameLayout>

                    <!-- Good -->
                    <FrameLayout
                        android:id="@+id/moodGoodContainer"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1">

                        <ImageButton
                            android:id="@+id/mood_good"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:background="@android:color/transparent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_mood_good"/>
                    </FrameLayout>

                    <!-- Neutral -->
                    <FrameLayout
                        android:id="@+id/moodNeutralContainer"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1">

                        <ImageButton
                            android:id="@+id/mood_neutral"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:background="@android:color/transparent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_mood_neutral"/>
                    </FrameLayout>

                    <!-- Sad -->
                    <FrameLayout
                        android:id="@+id/moodSadContainer"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1">

                        <ImageButton
                            android:id="@+id/mood_sad"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:background="@android:color/transparent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_mood_sad"/>
                    </FrameLayout>

                    <!-- Miserable -->
                    <FrameLayout
                        android:id="@+id/moodMiserableContainer"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1">

                        <ImageButton
                            android:id="@+id/mood_miserable"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:alpha="0.45"
                            android:background="@android:color/transparent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_mood_miserable"/>
                    </FrameLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- 3. Tasks Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today Tasks"
                android:textColor="#2D2D2D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnViewAllTasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="View All >"
                android:textColor="#8E8E93"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- کانتینر تسک‌ها -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:nestedScrollingEnabled="false" />

        <!-- کارت افقی وضعیت تسک‌ها (Empty / All Completed State) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardUseCompatPadding="false"
            android:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <!-- عکس تصویر: با هر نسبت ابعادی کار می‌کند و به راحتی با layout_width یا layout_height بزرگ/کوچک می‌شود -->
                <!-- عکس -->
                <ImageView
                    android:id="@+id/imgEmptyStateIcon"
                    android:layout_width="150dp"
                    android:layout_height="100dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ic_task_clipboard"
                    android:scaleType="fitCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- گروه متن و دکمه -->
                <LinearLayout
                    android:id="@+id/emptyStateContent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    app:layout_constraintStart_toEndOf="@id/imgEmptyStateIcon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- عنوان -->
                    <TextView
                        android:id="@+id/tvEmptyStateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="No tasks for today"
                        android:textColor="#212121"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <!-- توضیح -->
                    <TextView
                        android:id="@+id/tvEmptyStateDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:text="Add a task to stay organized and get started."
                        android:textColor="#757575"
                        android:textSize="12sp" />

                    <!-- دکمه -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyStateAction"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Add Task"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="19dp"
                        app:elevation="0dp"
                        app:icon="@drawable/ic_plus"
                        app:iconSize="14dp"
                        app:iconPadding="6dp"
                        app:iconTint="#FFFFFF"
                        app:iconGravity="textStart"
                        app:backgroundTint="#7C5FC2" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>




        <!-- 4. هدر بخش سلامت -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health Overview"
                android:textColor="#2D2D2D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnViewAllHealth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="View All >"
                android:textColor="#8E8E93"
                android:textSize="14sp" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHealthOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />


        <!-- Diary Shortcut Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardDiaryShortcut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-3dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="-3dp"
            android:background="@drawable/bg_diary_reflection_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Icon Circle -->
            <FrameLayout
                android:id="@+id/diaryIconContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_diary_icon_circle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/diary_icon"
                    android:src="@drawable/ic_diary_pencil" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvDiaryReflectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/diary_reflection"
                android:textColor="#171717"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imgDiaryCutie"
                app:layout_constraintTop_toBottomOf="@id/diaryIconContainer" />

            <!-- Reflection question -->
            <TextView
                android:id="@+id/tvDiaryReflectionQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/diary_entries_default"
                android:textColor="#2A2A2A"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imgDiaryCutie"
                app:layout_constraintTop_toBottomOf="@id/tvDiaryReflectionTitle" />

            <!-- Preview box -->
            <TextView
                android:id="@+id/tvDiaryLastEntry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_diary_preview"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="start|top"
                android:maxLines="2"
                android:padding="14dp"
                android:text="@string/diary_preview_default"
                android:textColor="#777777"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imgDiaryCutie"
                app:layout_constraintTop_toBottomOf="@id/tvDiaryReflectionQuestion" />

            <!-- Cutie Image -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgDiaryCutie"
                android:layout_width="118dp"
                android:layout_height="150dp"
                android:contentDescription="@string/diary_cutie"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/diary_cutie"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
