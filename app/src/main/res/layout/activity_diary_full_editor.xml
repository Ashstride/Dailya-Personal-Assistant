<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/diaryDetailScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/task_purple_light"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="30dp">

        <RelativeLayout
            android:id="@+id/diaryDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <ImageButton
                android:id="@+id/btnBackDiaryDetail"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#7E6CCA" />

            <TextView
                android:id="@+id/tvDiaryDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Write Entry"
                android:textColor="#1E1E1E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDiaryDetailEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="false"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@id/tvDiaryDetailTitle"
                android:text="📔"
                android:textSize="21sp" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tvReflectionQuestionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Today's Reflection"
            android:textColor="#1C1C1C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDiaryTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_soft"
            android:hint="Title of your story..."
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#202020"
            android:textColorHint="#A0A0A0"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etDiaryContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="370dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_soft"
            android:gravity="top|start"
            android:hint="Tell me everything..."
            android:inputType="textCapSentences|textMultiLine"
            android:overScrollMode="never"
            android:padding="16dp"
            android:scrollHorizontally="false"
            android:scrollbars="none"
            android:textColor="#202020"
            android:textColorHint="#A0A0A0"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="How was your mood today?"
            android:textColor="#2A2A2A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutMoodContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mood_container"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/diaryMoodHappy"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Happy mood"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mood_happy" />

            <ImageButton
                android:id="@+id/diaryMoodGood"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Good mood"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mood_good" />

            <ImageButton
                android:id="@+id/diaryMoodNeutral"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Neutral mood"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mood_neutral" />

            <ImageButton
                android:id="@+id/diaryMoodSad"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Sad mood"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mood_sad" />

            <ImageButton
                android:id="@+id/diaryMoodMiserable"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Miserable mood"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mood_miserable" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnWriteEntry"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_all"
            android:elevation="2dp"
            android:gravity="center"
            android:text="Save Your Entry"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
