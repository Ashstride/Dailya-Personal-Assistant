<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/actionsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/actionEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_popup_edit"
            android:elevation="8dp"
            android:gravity="center_vertical|start"
            android:layoutDirection="ltr"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:drawableStart="@drawable/ic_edit_pencil"
            android:drawablePadding="6dp"
            android:text="Edit task"
            android:textColor="#6C63FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/actionDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_popup_delete"
            android:elevation="8dp"
            android:gravity="center_vertical|start"
            android:layoutDirection="ltr"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:drawableStart="@drawable/ic_delete_trash"
            android:drawablePadding="6dp"
            android:text="Delete task"
            android:textColor="#E53935"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
