<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Bottom Sheet Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Title and current Mood -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@id/ivDetailMood"
            android:gravity="start"
            android:maxLines="2"
            android:text="Diary Title"
            android:textAlignment="viewStart"
            android:textColor="#1E1E1E"
            android:textDirection="firstStrong"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivDetailMood"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:contentDescription="Diary mood"
            android:src="@drawable/ic_mood_neutral" />

    </RelativeLayout>


    <!-- Date -->
    <TextView
        android:id="@+id/tvDetailDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Jul 19, 2026"
        android:textColor="#8A8A8A"
        android:textSize="13sp" />

    <!-- =================================== -->
    <!-- View Mode -->
    <!-- =================================== -->
    <LinearLayout
        android:id="@+id/layoutViewMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Diary Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="18dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Full content here"
                android:textColor="#444444"
                android:textSize="16sp" />

        </androidx.core.widget.NestedScrollView>

        <!-- Delete and Edit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDeleteEntry"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/overdue_normal_bg"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="#E53935" />

            <Button
                android:id="@+id/btnEditEntry"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/all_selected_bg"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

    <!-- =================================== -->
    <!-- Edit Mode -->
    <!-- =================================== -->
    <LinearLayout
        android:id="@+id/layoutEditMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Edit your diary"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Title"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_soft"
            android:hint="Diary title"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Content"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- Editable Diary Content -->
        <EditText
            android:id="@+id/etEditContent"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_soft"
            android:gravity="top|start"
            android:hint="Write your diary..."
            android:inputType="textCapSentences|textMultiLine"
            android:lineSpacingExtra="4dp"
            android:maxLines="8"
            android:minLines="5"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:textSize="16sp" />

        <!-- Mood Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Choose your mood"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Mood Selection -->
        <LinearLayout
            android:id="@+id/layoutEditMoods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivEditMoodHappy"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="Happy"
                android:padding="4dp"
                android:src="@drawable/ic_mood_happy" />

            <ImageView
                android:id="@+id/ivEditMoodGood"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="Good"
                android:padding="4dp"
                android:src="@drawable/ic_mood_good" />

            <ImageView
                android:id="@+id/ivEditMoodNeutral"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="Neutral"
                android:padding="4dp"
                android:src="@drawable/ic_mood_neutral" />

            <ImageView
                android:id="@+id/ivEditMoodSad"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="Sad"
                android:padding="4dp"
                android:src="@drawable/ic_mood_sad" />

            <ImageView
                android:id="@+id/ivEditMoodMiserable"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="8dp"
                android:contentDescription="Miserable"
                android:padding="4dp"
                android:src="@drawable/ic_mood_miserable" />

        </LinearLayout>

        <!-- Cancel and Save -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelEdit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="#EEEEEE"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#555555" />

            <Button
                android:id="@+id/btnSaveEdit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/task_purple"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
