<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3D725A">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnMaybeLater"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:id="@+id/imageContainer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/imgNotificationPermission"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/notification_permission_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/notif" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Notification Permission"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="Allow Dailya to send you reminders so you never miss what matters. 💛"
                android:textColor="#E0E0E0"
                android:textSize="15sp" />

            <!-- 🔔 باکس ۱: Notifications -->
            <LinearLayout
                android:id="@+id/rowNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_permission_item"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#F0EEFF"
                    android:contentDescription="notifications icon"
                    android:padding="12dp"
                    android:src="@drawable/ic_perm_notification" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notifications"
                        android:textColor="#2D3142"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allow Dailya to send you notifications and reminders."
                        android:textColor="#9094A6"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iconNotification"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_lock" />

                <ImageView
                    android:id="@+id/chevronNotification"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#BCBFCB" />
            </LinearLayout>

            <!-- ⏰ باکس ۲: Exact Alarms -->
            <LinearLayout
                android:id="@+id/rowExactAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_permission_item"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#E3F2FD"
                    android:contentDescription="exact alarm icon"
                    android:padding="12dp"
                    android:src="@drawable/ic_perm_alarm" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exact Alarms"
                        android:textColor="#2D3142"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allow exact alarms to ensure timely task reminders."
                        android:textColor="#9094A6"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iconExactAlarm"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_lock" />

                <ImageView
                    android:id="@+id/chevronExactAlarm"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#BCBFCB" />
            </LinearLayout>

            <!-- ⚡ باکس ۳: Background Activity -->
            <LinearLayout
                android:id="@+id/rowBatteryOpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_permission_item"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#FFF8E1"
                    android:contentDescription="background activity icon"
                    android:padding="12dp"
                    android:src="@drawable/ic_perm_battery" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Background Activity"
                        android:textColor="#2D3142"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allow unrestricted battery access&#10;so reminders work reliably."
                        android:textColor="#9094A6"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iconBatteryOpt"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_lock" />

                <ImageView
                    android:id="@+id/chevronBatteryOpt"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#BCBFCB" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMaybeLater"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        android:background="@drawable/bg_save_task_button"
        android:backgroundTint="#4E846B"
        android:drawableEnd="@drawable/ic_arrow_forward_white"
        android:drawablePadding="4dp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="Maybe Later"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/txtPrivacy" />

    <TextView
        android:id="@+id/txtPrivacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="🛡️ Your privacy matters. Change settings anytime."
        android:textColor="#B0C4BB"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
