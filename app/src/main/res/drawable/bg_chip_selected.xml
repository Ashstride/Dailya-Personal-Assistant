<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- رنگ پس‌زمینه چیپ فعال (آبی نیلی مدرن/مینیمال) -->
    <solid android:color="#4F46E5" />

    <!-- گوشه‌های کاملاً گرد استاندارد دکمه‌های چیپ -->
    <corners android:radius="100dp" />

    <!-- پدینگ داخلی برای حفظ فاصله متن از دیواره‌ها -->
    <padding
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="8dp" />
</shape>
